<?xml version="1.0" encoding="utf-8"?>
<!-- WorkforceOS Compact Bar Widget (2×1 / 3×1 cell) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Left: Logo + Name + Status column -->
    <LinearLayout
        android:id="@+id/compact_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="WorkforceOS" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Member"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Status pill with explicit background so RemoteViews setBackgroundResource works -->
            <TextView
                android:id="@+id/widget_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_status_out"
                android:text="CLOCKED OUT"
                android:textColor="#475569"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: Action Button anchored to right center -->
    <LinearLayout
        android:id="@+id/widget_action_button"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_btn_clock_in"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOCK IN"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:maxLines="1" />
    </LinearLayout>

</RelativeLayout>
